# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only — required for the "Create New User" admin flow (src/app/api/admin/create-user).
# NEVER prefix this with NEXT_PUBLIC_ — it must stay server-side only.
# Get it from: Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Server-only — Bendie Planner's separate Supabase project (member/agenda push,
# travel pull). No anon key needed: the portal never runs an end-user session
# against Planner's project, only server-side service-role calls from
# src/app/api/admin/planner-*/route.ts.
# NEVER prefix PLANNER_SUPABASE_SERVICE_ROLE_KEY with NEXT_PUBLIC_.
PLANNER_SUPABASE_URL=https://your-planner-project.supabase.co
PLANNER_SUPABASE_SERVICE_ROLE_KEY=your_planner_service_role_key

# App Configuration
NEXT_PUBLIC_APP_NAME=Event Content Portal
NEXT_PUBLIC_APP_VERSION=1.0.0

# Optional: Error tracking
NEXT_PUBLIC_SENTRY_DSN=

# Optional: Analytics
NEXT_PUBLIC_ANALYTICS_ID=
